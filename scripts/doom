#!/bin/sh
# Fit the ASCII renderer (two terminal columns per pixel) to the SSH PTY.
set -eu
if ! test -t 0; then
    echo "Run with a terminal: ssh -t root@luckfox doom" >&2
    exit 1
fi
cd /opt/doom
size=$(stty size)
rows=${size% *}
cols=${size#* }
[ "$rows" -gt 1 ] || rows=25
[ "$cols" -gt 0 ] || cols=80
scale=$(( (640 + cols - 1) / cols ))
y_scale=$(( (200 + rows - 2) / (rows - 1) ))
[ "$scale" -ge "$y_scale" ] || scale=$y_scale
[ "$scale" -ge 4 ] || scale=4
for arg in "$@"; do
    [ "$arg" != "-sixel" ] || scale=1
done
saved=$(stty -g)
game_pid=
# End an interrupted Sixel string before restoring the terminal.
restore_terminal() {
    printf '\033\\'
    printf '\033[0m\033[?25h\033[?1049l'
    stty "$saved"
}
trap restore_terminal EXIT
stop_game() {
    if [ -n "$game_pid" ]; then
        kill -TERM "$game_pid" 2>/dev/null || true
        wait "$game_pid" 2>/dev/null || true
    fi
    exit "$1"
}
trap 'stop_game 130' INT
trap 'stop_game 143' TERM HUP
printf '\033[?1049h'
exec 3<&0
./doom-ascii -iwad doom1.wad -config .default.cfg -fixgamma -scaling "$scale" "$@" <&3 3<&- &
game_pid=$!
exec 3<&-
wait "$game_pid"
